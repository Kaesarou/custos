# App
CUSTOS_HTTP_PORT=8080
CUSTOS_API_BASE_PATH=/api/v1
CUSTOS_NODE_VERSION=0.1.0-SNAPSHOT

# Local blockchain
CUSTOS_TEST_CHAIN_PORT=8545
CUSTOS_CHAIN_31337_RPC_URL=http://custos-test-chain:8545

# Node identity
# Hardhat dev private key for local node signing.
CUSTOS_NODE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Empty = generated roman node id from node address
CUSTOS_NODE_ID=

# Empty = reward address defaults to node address
CUSTOS_NODE_REWARD_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# In dev single-node mode, localhost is OK because you call the node from your host machine.
# In multi-node Docker tests later, this should become http://custos-node-X:8080.
CUSTOS_NODE_PUBLIC_BASE_URL=http://localhost:8080

# Empty for now. Later we will use this for network/view tests.
CUSTOS_NODE_PEERS=

# Postgres
POSTGRES_DB=custos
POSTGRES_USER=custos
POSTGRES_PASSWORD=custos
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8081

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false