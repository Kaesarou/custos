# Docker image
CUSTOS_NODE_IMAGE=custos/custos-node:latest
CUSTOS_NODE_CONTAINER_NAME=custos-node

# HTTP
CUSTOS_HTTP_PORT=8080
CUSTOS_API_BASE_PATH=/api/v1

# Node identity
# Required in v1.
CUSTOS_NODE_PRIVATE_KEY=0xCHANGE_ME

# Optional. If empty, the node will generate a stable roman node id from the node address.
CUSTOS_NODE_ID=

# Optional. If empty, rewardAddress defaults to the node address.
CUSTOS_NODE_REWARD_ADDRESS=

# Required in v1. Must be reachable by other Custos nodes.
# Do not use localhost in production.
CUSTOS_NODE_PUBLIC_BASE_URL=https://your-node.example.com

# Bootstrap peers / known peers.
CUSTOS_NODE_PEERS=https://bootstrap-1.custos.network,https://bootstrap-2.custos.network

# Chain RPC
# For real usage, replace with the target chain RPC.
CUSTOS_CHAIN_31337_RPC_URL=https://your-rpc.example.com

# Database
POSTGRES_CONTAINER_NAME=custos-postgres
POSTGRES_DB=custos
POSTGRES_USER=custos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false